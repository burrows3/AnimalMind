# SECURITY: Never commit this file with real values. Copy to .env and add secrets locally.
# Do not commit .env – it is in .gitignore.

# Moltbook "Sign in with Moltbook" – app API key from https://moltbook.com/developers/dashboard
MOLTBOOK_APP_KEY=

# Optional: audience for token verification (e.g. your domain). Use if bots issue tokens with audience restriction.
# MOLTBOOK_AUDIENCE=yourapp.com

# Optional hardening: protects non-UI API endpoints (/api/ingested and /api/repurpose/*).
# Set a strong random value and send it via header: x-internal-api-key
# INTERNAL_API_KEY=
